---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Sarah Pemberton Greenway',
  description = 'Policy strategist and advocate for economic equity and community development.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Sarah Speaks Policy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-inner">
        <a href="/" class="wordmark">
          Sarah<span>Speaks</span>Policy
        </a>
        <ul class="nav-links">
          <li><a href="/on-background" class={currentPath.startsWith('/on-background') ? 'active' : ''}>On Background</a></li>
          <li><a href="/policy-and-work" class={currentPath.startsWith('/policy-and-work') ? 'active' : ''}>Policy & Work</a></li>
          <li><a href="/marginalia" class={currentPath.startsWith('/marginalia') ? 'active' : ''}>Marginalia</a></li>
          <li><a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a></li>
        </ul>
        <button class="hamburger" aria-label="Toggle menu" id="hamburger">
          <span></span><span></span><span></span>
        </button>
      </nav>
      <div class="mobile-menu" id="mobileMenu">
        <a href="/on-background">About</a>
        <a href="/policy-and-work">Policy & Work</a>
        <a href="/marginalia">Marginalia</a>
        <a href="/contact">Contact</a>
      </div>
    </header>

    <main>
      <slot />
    </main>


    <footer class="site-footer">
      <span>&copy; {new Date().getFullYear()}</span>
      <span class="footer-wordmark">Sarah Speaks Policy</span>
      <span>St. Petersburg, FL</span>
    </footer>

    <script>
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobileMenu');
      hamburger?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('open');
        hamburger.classList.toggle('active');
      });
    </script>
  </body>
</html>