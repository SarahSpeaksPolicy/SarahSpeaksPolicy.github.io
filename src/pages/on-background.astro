---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';
import { toHTML } from '@portabletext/to-html';

let about: any = null;
try {
  about = await sanityClient.fetch(`*[_type == "onBackground"][0]{ ..., "resume": resume{ "asset": asset-> } }`);
} catch (e) {}

const fullBioHTML = about?.fullBio ? toHTML(about.fullBio) : null;
const education = about?.education ?? [];
const experience = about?.experience ?? [];
const resumeUrl = about?.resume?.asset?.url ?? null;
---

<Layout title="On Background — Sarah Speaks Policy" description="Biography, education, and experience of Sarah Pemberton Greenway.">

  <div class="page-title">
    <div class="page-label">On Background</div>
    <h1 class="page-heading page-heading--display">Sarah Pemberton Greenway</h1>
    <div class="page-subtitle">Policy strategist</div>
  </div>

  <div class="bio-prose">
    {fullBioHTML
      ? <Fragment set:html={fullBioHTML} />
      : <>
          <p class="placeholder">[A paragraph of biography will live here — three to four sentences that place you in the world of policy work, your current focus, and what you care about.]</p>
          <p class="placeholder">[A second paragraph, more personal — your trajectory, the through-line that connects what you've done to what you're doing now.]</p>
          <p class="placeholder">[A closing paragraph — what you're working on now, what you're writing about, and where you're based.]</p>
        </>
    }
  </div>

  {education.length > 0 && (
    <div class="credentials">
      <div class="credentials-block">
        <div class="section-label">Education</div>
        {education.map((e: any) => (
          <div class="credential-row">
            <span>{e.institution}</span>
            <span class="detail">{e.degree}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {experience.length > 0 && (
    <div class="credentials">
      <div class="credentials-block">
        <div class="section-label">Selected experience</div>
        {experience.map((e: any) => (
          <div class="credential-row">
            <span>{e.organization}</span>
            <span class="detail">{e.role}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {resumeUrl && (
    <div class="resume-row">
      <a href={resumeUrl} download class="resume-link">Download Resume (PDF) &#8594;</a>
    </div>
  )}

  <div class="monogram monogram--signature">
    <svg viewBox="0 0 40 28" xmlns="http://www.w3.org/2000/svg">
      <path d="M 8 14 Q 14 6, 20 14 T 32 14" stroke="#2A1810" stroke-width="0.8" fill="none" stroke-linecap="round"/>
      <text x="20" y="22" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-size="10" fill="#2A1810" opacity="0.7">spg</text>
    </svg>
  </div>

</Layout>

<style>
  .resume-row {
    max-width: var(--max-medium);
    margin: 0 auto;
    padding: 0 var(--pad-x) 3rem;
  }
  .resume-link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-accent);
  }
  .resume-link:hover { opacity: 0.7; }
</style>
