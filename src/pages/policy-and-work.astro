---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';

let works: any[] = [];
try {
  works = await sanityClient.fetch(`
    *[_type == "policyAndWork"] | order(publishedAt desc) {
      _id, title, description, publishedAt,
      "category": category->title,
      "fileUrl": file.asset->url,
      externalUrl
    }
  `);
} catch (e) {}

function getYear(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).getFullYear().toString();
}
---

<Layout title="Policy & Work — Sarah Speaks Policy" description="Policy writing, research, and selected work by Sarah Pemberton Greenway.">

  <div class="page-title">
    <div class="page-label">Policy and Work</div>
    <h1 class="page-heading">[Page tagline — written later.]</h1>
    <div class="page-subhead">[One to two sentence description of what lives here.]</div>
  </div>

  <section class="container-wide" style="padding-top: 3rem; padding-bottom: 4rem;">
    <div class="portfolio-list">
      {works.length > 0
        ? works.map((item: any) => {
            const href = item.fileUrl ?? item.externalUrl ?? '#';
            const meta = [item.category, getYear(item.publishedAt)].filter(Boolean).join(' · ');
            return (
              <a href={href} class="portfolio-piece" target={item.externalUrl ? '_blank' : undefined} rel={item.externalUrl ? 'noopener' : undefined} download={item.fileUrl ? true : undefined} style="display: block;">
                <div class="meta-row">
                  <span class="meta">{meta || 'Work'}</span>
                  <span class="arrow">&#8594;</span>
                </div>
                <h2 class="title">{item.title}</h2>
                {item.description && <p class="description">{item.description}</p>}
              </a>
            );
          })
        : <>
            <a href="#" class="portfolio-piece" style="display: block; opacity: 0.4; pointer-events: none;">
              <div class="meta-row">
                <span class="meta">Capstone &middot; 2026</span>
                <span class="arrow">&#8594;</span>
              </div>
              <h2 class="title">Mutual Capital Impact</h2>
              <p class="description">A policy framework for employer-governed pooled capital in regional economic development.</p>
            </a>
            <a href="#" class="portfolio-piece" style="display: block; opacity: 0.4; pointer-events: none;">
              <div class="meta-row">
                <span class="meta">[Category] &middot; [Year]</span>
                <span class="arrow">&#8594;</span>
              </div>
              <h2 class="title">[Piece title]</h2>
              <p class="description">[One-line description of the piece.]</p>
            </a>
          </>
      }
    </div>
  </section>

</Layout>
