---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';

let posts: any[] = [];
try {
  posts = await sanityClient.fetch(`
    *[_type == "post"] | order(publishedAt desc) {
      _id,
      title,
      slug,
      publishedAt,
      excerpt,
      "category": category->title
    }
  `);
} catch (e) {
  // Sanity not configured yet
}

const placeholderPosts = [
  {
    _id: '1',
    title: 'Why Zip Code Still Predicts Economic Destiny',
    slug: { current: '#' },
    publishedAt: '2024-11-15',
    excerpt: 'A deep look at how place-based inequality compounds across generations — and the policy levers that can actually move the needle.',
    category: 'Economic Equity',
  },
  {
    _id: '2',
    title: 'The Workforce Gap Nobody Talks About',
    slug: { current: '#' },
    publishedAt: '2024-10-02',
    excerpt: "Middle-skill jobs are disappearing faster than we're retraining workers. Here's what an honest policy response looks like.",
    category: 'Workforce Development',
  },
  {
    _id: '3',
    title: 'Community Investment That Actually Works',
    slug: { current: '#' },
    publishedAt: '2024-09-10',
    excerpt: 'Not all development is created equal. The difference between displacement and genuine uplift comes down to who holds the accountability.',
    category: 'Community Investment',
  },
];

const displayPosts = posts.length > 0 ? posts : placeholderPosts;

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Writing — Sarah Pemberton Greenway">
  <div class="blog-hero">
    <div class="container">
      <p class="section-label">Writing & Analysis</p>
      <h1>Sarah's Policy Thinking</h1>
      <p class="hero-sub">Essays, analysis, and commentary on economic equity, development policy, and the systems that shape community outcomes.</p>
    </div>
  </div>

  <section class="blog-list section-pad">
    <div class="container">
      <div class="posts-grid">
        {displayPosts.map((post, i) => (
          <article class={`post-card ${i === 0 ? 'featured' : ''}`}>
            {post.category && <span class="post-cat">{post.category}</span>}
            <h2 class="post-title">
              <a href={`/blog/${post.slug.current}`}>{post.title}</a>
            </h2>
            <p class="post-excerpt">{post.excerpt}</p>
            <div class="post-meta">
              <time>{formatDate(post.publishedAt)}</time>
              <a href={`/blog/${post.slug.current}`} class="read-more">Read more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    background: var(--navy);
    color: white;
    padding: clamp(4rem, 10vw, 8rem) 0 clamp(3rem, 7vw, 6rem);
  }
  .blog-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: white;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .blog-hero .section-label { color: var(--gold-light); }
  .hero-sub { color: rgba(255,255,255,0.65); max-width: 560px; font-size: 1.05rem; line-height: 1.8; }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .post-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2rem;
    background: white;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: box-shadow 0.25s, transform 0.2s;
  }
  .post-card:hover { box-shadow: 0 8px 32px rgba(15,31,61,0.08); transform: translateY(-2px); }
  .post-card.featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
    padding: 2.5rem;
    background: var(--cream);
  }
  .post-card.featured .post-title { font-size: clamp(1.4rem, 2.5vw, 1.9rem); }
  .post-card.featured .post-excerpt { font-size: 1.05rem; }

  .post-cat {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    align-self: flex-start;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--navy);
    margin: 0;
  }
  .post-title a { transition: color 0.2s; }
  .post-title a:hover { color: var(--gold); }

  .post-excerpt { color: var(--text-muted); font-size: 0.95rem; line-height: 1.75; flex: 1; }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .read-more {
    color: var(--gold);
    font-weight: 600;
    transition: color 0.2s;
  }
  .read-more:hover { color: var(--navy); }

  @media (max-width: 700px) {
    .post-card.featured { grid-template-columns: 1fr; }
  }
</style>
