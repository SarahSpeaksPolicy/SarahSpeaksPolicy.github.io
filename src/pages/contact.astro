---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';

let data: any = null;
try {
  data = await sanityClient.fetch(`*[_type == "contact"][0]`);
} catch (e) {}

const email = data?.email ?? null;
const pageTagline = data?.pageTagline ?? '[Page tagline — written later.]';
const pageSubhead = data?.pageSubhead ?? '[A line about how to reach you — written later.]';
const socialLinks = data?.socialLinks ?? [];
---

<Layout title="Contact — Sarah Speaks Policy" description="Get in touch with Sarah Pemberton Greenway.">

  <div class="page-title">
    <div class="page-label">Contact</div>
    <h1 class="page-heading">{pageTagline}</h1>
    <div class="page-subhead">{pageSubhead}</div>
  </div>

  <section style="max-width: 480px; margin: 0 auto; padding: 2rem var(--pad-x) 3rem;">

    {email && (
      <div class="contact-email">
        <div class="label">By email</div>
        <a href={`mailto:${email}`} class="address">{email}</a>
      </div>
    )}

    {socialLinks.length > 0 && (
      <div class="elsewhere">
        <div class="group-label">Elsewhere</div>
        {socialLinks.map((link: any) => (
          <a href={link.url} class="elsewhere-link" target="_blank" rel="noopener">
            <div>
              <div class="name">{link.name}</div>
              {link.context && <div class="context">{link.context}</div>}
            </div>
            <div class="arrow">&#8594;</div>
          </a>
        ))}
      </div>
    )}

  </section>

  <div class="monogram" style="justify-content: flex-start;">
    <img src="/smooth_small.png" alt="Sarah Pemberton Greenway signature" style="width: 5rem; opacity: 0.60;" />
  </div>

</Layout>
