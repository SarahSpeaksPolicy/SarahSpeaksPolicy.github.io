---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';
import imageUrlBuilder from '@sanity/image-url';

let about: any = null;
try {
  about = await sanityClient.fetch(`*[_type == "onBackground"][0]{
    positioningStatement, photo
  }`);
} catch (e) {}

const hasContent = !!about?.positioningStatement;
const positioning = about?.positioningStatement ?? 'Positioning Statement Fallback';

let photoUrl: string | null = null;
if (about?.photo?.asset) {
  const builder = imageUrlBuilder(sanityClient);
  photoUrl = builder.image(about.photo).width(800).height(1000).fit('crop').url();
}
---

<Layout title="Sarah Pemberton Greenway — Policy Strategist">

      <section class="home-hero">
      <!-- Replace the inline background with your actual hero image -->
        {photoUrl
          ? <div class="home-portrait" style={`background-image: url('${photoUrl}');`}></div>
          : <div class="home-portrait photo-placeholder"><span>SPG</span></div>
        }
      

      <div>
        <div class="page-label">Sarah Pemberton Greenway</div>
        <h1 class="home-line">{positioning}</h1>
        <div class="monogram" style="justify-content: flex-start;">
          <img src="/smooth_small.png" alt="Sarah Pemberton Greenway signature" style="width: 5rem; opacity: 0.60;" />
        </div>
      </div>
    </section>

    <section class="container-medium" style="padding-top: 1.5rem; padding-bottom: 5rem;">
      <div class="action-list">
        <a href="/on-background" class="action-row">
          <span class="label">On Background</span>
          <span class="arrow">&#8594;</span>
        </a>
        <a href="/policy-and-work" class="action-row">
          <span class="label">Policy and Work</span>
          <span class="arrow">&#8594;</span>
        </a>
        <a href="/marginalia" class="action-row">
          <span class="label">Marginalia</span>
          <span class="arrow">&#8594;</span>
        </a>
        <a href="/contact" class="action-row">
          <span class="label">Contact</span>
          <span class="arrow">&#8594;</span>
        </a>
      </div>

</Layout>
