---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';

// Fetch homepage data from Sanity — falls back to placeholder content gracefully
let hero: any = null;
let about: any = null;
let focusAreas: any[] = [];

try {
  hero = await sanityClient.fetch(`*[_type == "hero"][0]`);
  about = await sanityClient.fetch(`*[_type == "about"][0]`);
  focusAreas = await sanityClient.fetch(`*[_type == "focusArea"] | order(order asc)`);
} catch (e) {
  // Sanity not yet configured — placeholders will render
}

const heroHeadline = hero?.headline ?? 'Policy with Purpose. Equity at the Center.';
const heroSubheading = hero?.subheading ?? 'Sarah Pemberton Greenway is a policy strategist driving economic equity and community development — bringing rigorous analysis and human-centered advocacy to the institutions that shape everyday life.';
const heroCta = hero?.ctaText ?? 'Read My Work';
const heroCtaLink = hero?.ctaLink ?? '/blog';

const aboutTitle = about?.title ?? 'About Sarah';
const aboutBio = about?.bio ?? `Sarah Pemberton Greenway has spent over a decade at the intersection of policy, community, and economic justice. From municipal budget advocacy to statewide development initiatives, she brings both analytical depth and a genuine commitment to the people policies are meant to serve.\n\nHer work centers a simple belief: economic opportunity shouldn't depend on your zip code. She has advised city councils, nonprofit coalitions, and legislative offices — always asking who gets left out of the room, and how to change that.`;

const defaultFocus = [
  { title: 'Economic Equity', description: 'Closing wealth gaps through targeted fiscal policy, equitable tax structures, and community investment frameworks that reach underserved populations.' },
  { title: 'Workforce Development', description: 'Building pathways to quality employment through policy that connects training, education, and job creation in ways that serve the whole community.' },
  { title: 'Community Investment', description: 'Directing public and private capital toward historically disinvested neighborhoods — with accountability structures that keep development equitable.' },
];
const displayFocus = focusAreas.length > 0 ? focusAreas : defaultFocus;
---

<Layout title="Sarah Pemberton Greenway — Policy Strategist">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-pattern" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-eyebrow">Policy Strategist &amp; Advocate</div>
      <h1 class="hero-headline">{heroHeadline}</h1>
      <p class="hero-sub">{heroSubheading}</p>
      <div class="hero-actions">
        <a href={heroCtaLink} class="btn-primary">{heroCta}</a>
        <a href="#about" class="btn-ghost">Learn More</a>
      </div>
    </div>
    <div class="hero-rule" aria-hidden="true"></div>
  </section>

  <!-- ABOUT -->
  <section class="about section-pad" id="about">
    <div class="container about-grid">
      <div class="about-img-wrap">
        <div class="about-img-placeholder" aria-label="Photo of Sarah Pemberton Greenway">
          <span>SPG</span>
        </div>
        <div class="about-badge">Economic Equity &amp; Development</div>
      </div>
      <div class="about-text">
        <p class="section-label">About</p>
        <h2>{aboutTitle}</h2>
        {aboutBio.split('\n\n').map((para: string) => (
          <p class="about-para">{para}</p>
        ))}
        <a href="#contact" class="btn-primary" style="margin-top:2rem;display:inline-block;">Work With Sarah</a>
      </div>
    </div>
  </section>

  <!-- FOCUS AREAS -->
  <section class="focus section-pad" id="focus">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Policy Focus</p>
        <h2>Where Sarah Directs Her Work</h2>
        <p class="section-sub">Grounded in evidence, driven by equity — these are the pillars that shape Sarah's policy approach.</p>
      </div>
      <div class="focus-grid">
        {displayFocus.map((area: any, i: number) => (
          <div class="focus-card">
            <div class="focus-num">0{i + 1}</div>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact section-pad" id="contact">
    <div class="container contact-grid">
      <div class="contact-text">
        <p class="section-label" style="color:var(--gold-light)">Get in Touch</p>
        <h2>Let's Talk Policy</h2>
        <p>Whether you're building a coalition, seeking strategic counsel, or looking for a voice on economic equity — Sarah would love to hear from you.</p>
      </div>
      <form class="contact-form" id="contactForm" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" placeholder="Jane Smith" required />
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required />
          </div>
        </div>
        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" placeholder="Speaking engagement, collaboration, press inquiry..." />
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Tell Sarah a bit about what you have in mind..." required></textarea>
        </div>
        <button type="submit" class="btn-primary btn-full">Send Message</button>
        <p class="form-note" id="formStatus"></p>
      </form>
    </div>
  </section>

</Layout>

<script>
  // Simple form → Formspree (or swap for your own endpoint)
  // Replace YOUR_FORM_ID with your Formspree form ID
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    try {
      const res = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        if (status) status.textContent = "Thanks! Sarah will be in touch soon.";
        form.reset();
      } else {
        if (status) status.textContent = "Something went wrong. Please try emailing directly.";
      }
    } catch {
      if (status) status.textContent = "Network error. Please try again.";
    }
  });
</script>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    background: var(--navy);
    color: white;
    overflow: hidden;
    padding: clamp(5rem, 14vw, 11rem) 2rem clamp(5rem, 10vw, 8rem);
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 70% 50%, rgba(200, 146, 42, 0.12) 0%, transparent 60%),
      repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 40px,
        rgba(255,255,255,0.015) 40px,
        rgba(255,255,255,0.015) 41px
      );
  }

  .hero-inner {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-light);
    border: 1px solid rgba(200,146,42,0.4);
    padding: 0.35rem 1rem;
    border-radius: 2px;
    margin-bottom: 2rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: rgba(255,255,255,0.72);
    max-width: 620px;
    margin: 0 auto 2.5rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--gold), var(--gold-light), transparent);
  }

  /* ── BUTTONS ── */
  .btn-primary {
    display: inline-block;
    background: var(--gold);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.8rem 2rem;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    letter-spacing: 0.02em;
  }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-1px); }
  .btn-full { width: 100%; text-align: center; padding: 1rem; }

  .btn-ghost {
    display: inline-block;
    color: rgba(255,255,255,0.8);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.8rem 2rem;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 4px;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: rgba(255,255,255,0.6); color: white; }

  /* ── SHARED ── */
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem; }
  .section-pad { padding: var(--section-pad) 0; }

  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--navy);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .section-header {
    max-width: 580px;
    margin-bottom: 3.5rem;
  }
  .section-sub {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── ABOUT ── */
  .about { background: var(--cream); }

  .about-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 5rem;
    align-items: start;
  }

  .about-img-wrap { position: relative; }

  .about-img-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    background: linear-gradient(145deg, var(--navy-mid), var(--navy));
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 900;
    color: rgba(255,255,255,0.15);
    letter-spacing: 0.05em;
  }

  .about-badge {
    position: absolute;
    bottom: -1.25rem;
    right: -1rem;
    background: var(--gold);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.6rem 1.1rem;
    border-radius: 3px;
    box-shadow: 0 4px 16px rgba(200,146,42,0.35);
  }

  .about-text h2 { margin-top: 0.25rem; }
  .about-para {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* ── FOCUS ── */
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .focus-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2.25rem 2rem;
    background: white;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.2s;
  }
  .focus-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
  }
  .focus-card:hover { box-shadow: 0 8px 32px rgba(15,31,61,0.1); transform: translateY(-3px); }

  .focus-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    color: rgba(200,146,42,0.18);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .focus-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }

  .focus-card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.75; }

  /* ── CONTACT ── */
  .contact {
    background: var(--navy);
    color: white;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-text h2 { color: white; }
  .contact-text p { color: rgba(255,255,255,0.65); font-size: 1.05rem; line-height: 1.8; margin-top: 1rem; }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }

  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  .form-group input,
  .form-group textarea {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 4px;
    padding: 0.75rem 1rem;
    color: white;
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color 0.2s;
    resize: vertical;
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder { color: rgba(255,255,255,0.25); }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--gold-light);
  }

  .form-note { font-size: 0.85rem; color: var(--gold-light); text-align: center; min-height: 1.2em; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-img-placeholder { aspect-ratio: 3/2; }
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
