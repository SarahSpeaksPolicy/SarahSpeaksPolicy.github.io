---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../lib/sanity';
import imageUrlBuilder from '@sanity/image-url';

let about: any = null;
try {
  about = await sanityClient.fetch(`*[_type == "about"][0]{
    positioningStatement, shortBio, photo
  }`);
} catch (e) {}

const hasContent = !!about?.positioningStatement;
const positioning = about?.positioningStatement ?? 'Policy with Purpose. Equity at the Center.';
const shortBio = about?.shortBio ?? 'Sarah Pemberton Greenway is a policy strategist driving economic equity and community development — bringing rigorous analysis and human-centered advocacy to the institutions that shape everyday life.';

let photoUrl: string | null = null;
if (about?.photo?.asset) {
  const builder = imageUrlBuilder(sanityClient);
  photoUrl = builder.image(about.photo).width(800).height(1000).fit('crop').url();
}
---

<Layout title="Sarah Pemberton Greenway — Policy Strategist">

  <section class="home-hero">
    <div class="home-hero-inner container">
      <div class="home-photo">
        {photoUrl
          ? <img src={photoUrl} alt="Sarah Pemberton Greenway" />
          : <div class="photo-placeholder"><span>SPG</span></div>
        }
      </div>
      <div class="home-intro">
        {!hasContent && (
          <div class="placeholder-notice">Sample content — update in Sanity Studio</div>
        )}
        <p class="eyebrow">Policy Strategist &amp; Advocate</p>
        <h1 class={!hasContent ? 'is-placeholder' : ''}>{positioning}</h1>
        <p class={`short-bio${!hasContent ? ' is-placeholder' : ''}`}>{shortBio}</p>
        <div class="hero-actions">
          <a href="/work" class="btn-primary">View My Work</a>
          <a href="/about" class="btn-ghost">Learn More</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .home-hero {
    min-height: calc(100vh - 68px);
    display: flex;
    align-items: center;
    background: var(--warm-white);
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .home-hero-inner {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 6rem;
    align-items: center;
  }

  .home-photo img,
  .photo-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 6px;
    object-fit: cover;
  }

  .home-photo img {
    filter: sepia(35%) contrast(0.6) brightness(0.8);
  }

  .photo-placeholder {
    background: linear-gradient(145deg, var(--navy-mid), var(--navy));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 900;
    color: rgba(255,255,255,0.15);
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: var(--navy);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .short-bio {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.85;
    max-width: 520px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    background: var(--navy);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.8rem 2rem;
    border-radius: 4px;
    transition: background 0.2s;
    letter-spacing: 0.02em;
  }
  .btn-primary:hover { background: var(--navy-mid); }

  .btn-ghost {
    display: inline-block;
    color: var(--navy);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.8rem 2rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--navy); }

  .placeholder-notice {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b07d2a;
    background: #fef3dc;
    border: 1px dashed #e8b455;
    border-radius: 4px;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.25rem;
  }

  h1.is-placeholder,
  .short-bio.is-placeholder { opacity: 0.4; font-style: italic; }

  @media (max-width: 960px) {
    .home-hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .home-photo {
      max-width: 360px;
      margin: 0 auto;
    }
    .home-intro { text-align: center; }
    .short-bio { margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
  }
</style>
