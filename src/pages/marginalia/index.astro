---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';

let posts: any[] = [];
let pageData: any = null;
try {
  [posts, pageData] = await Promise.all([
    sanityClient.fetch(`
      *[_type == "marginalia"] | order(publishedAt desc) {
        _id, title, slug, publishedAt, excerpt
      }
    `),
    sanityClient.fetch(`*[_type == "marginaliaPage"][0]{ pageHeading, pageSubhead }`),
  ]);
} catch (e) {}

const pageHeading = pageData?.pageHeading ?? 'Intellectual Sketches';
const pageSubhead = pageData?.pageSubhead ?? 'Short reflections, commentary on current issues, and book notes — thinking in progress.';

const placeholderPosts = [
  {
    _id: '1',
    title: 'Marginalia Fake #1',
    slug: { current: '#' },
    publishedAt: '2024-11-15',
    excerpt: 'Vestibulum non lacus viverra ligula faucibus cursus.',
  },
  {
    _id: '2',
    title: 'Marginalia Fake #2',
    slug: { current: '#' },
    publishedAt: '2024-10-02',
    excerpt: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
  },
  {
    _id: '3',
    title: 'Marginalia Fake #3',
    slug: { current: '#' },
    publishedAt: '2024-09-10',
    excerpt: 'Pellentesque bibendum neque eget ex condimentum, quis volutpat dolor cursus.',
  },
];

const hasContent = posts.length > 0;
const displayPosts = hasContent ? posts : placeholderPosts;

function formatShortDate(str: string) {
  const d = new Date(str);
  return {
    mon: d.toLocaleDateString('en-US', { month: 'short' }),
    day: d.getDate(),
  };
}
---

<Layout title="Marginalia — Sarah Speaks Policy" description="Short reflections, commentary, and book notes from Sarah Pemberton Greenway.">

  <div class="page-title">
    <div class="page-label">Marginalia</div>
    <h1 class="page-heading">{pageHeading}</h1>
    <div class="page-subhead">{pageSubhead}</div>
  </div>

  <section class="container-wide" style="padding-top: 3rem; padding-bottom: 4rem;">
    {!hasContent && (
      <div class="placeholder-notice">
        Sample content — add real entries in Sanity Studio to replace this.
      </div>
    )}
    <div class={`marginalia-list${!hasContent ? ' is-placeholder' : ''}`}>
      {displayPosts.map((post: any) => {
        const { mon, day } = formatShortDate(post.publishedAt);
        return (
          <a
            href={`/marginalia/${post.slug.current}`}
            class="marginalia-entry"
            style={!hasContent ? 'opacity: 0.45; pointer-events: none;' : ''}
          >
            <div class="date">{mon}<br />{day}</div>
            <div>
              <div class="title">{post.title}</div>
              {post.excerpt && <div class="description">{post.excerpt}</div>}
            </div>
            <div class="arrow">&#8594;</div>
          </a>
        );
      })}
    </div>
  </section>

</Layout>

<style>
  .placeholder-notice {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    border: 1px dashed var(--color-rule-strong);
    border-radius: 4px;
    padding: 0.45rem 1rem;
    margin-bottom: 2.5rem;
  }
</style>
