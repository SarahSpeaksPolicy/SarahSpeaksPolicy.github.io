---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';

let posts: any[] = [];
try {
  posts = await sanityClient.fetch(`
    *[_type == "marginalia"] | order(publishedAt desc) {
      _id, title, slug, publishedAt, excerpt,
      "category": category->title
    }
  `);
} catch (e) {}

const placeholderPosts = [
  {
    _id: '1',
    title: 'Why Zip Code Still Predicts Economic Destiny',
    slug: { current: '#' },
    publishedAt: '2024-11-15',
    excerpt: 'A deep look at how place-based inequality compounds across generations — and the policy levers that can actually move the needle.',
    category: 'Economic Equity',
  },
  {
    _id: '2',
    title: 'The Workforce Gap Nobody Talks About',
    slug: { current: '#' },
    publishedAt: '2024-10-02',
    excerpt: "Middle-skill jobs are disappearing faster than we're retraining workers. Here's what an honest policy response looks like.",
    category: 'Workforce Development',
  },
  {
    _id: '3',
    title: 'Community Investment That Actually Works',
    slug: { current: '#' },
    publishedAt: '2024-09-10',
    excerpt: 'Not all development is created equal. The difference between displacement and genuine uplift comes down to who holds the accountability.',
    category: 'Community Investment',
  },
];

const hasContent = posts.length > 0;
const displayPosts = hasContent ? posts : placeholderPosts;

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Marginalia — Sarah Pemberton Greenway" description="Short reflections, commentary, and book notes from Sarah Pemberton Greenway.">

  <div class="page-hero">
    <div class="container">
      <span class="section-label">Marginalia</span>
      <h1>Intellectual Sketches</h1>
      <p>Short reflections, commentary on current issues, and book notes — thinking in progress.</p>
    </div>
  </div>

  <section class="posts-body container section-pad">
    {!hasContent && (
      <div class="placeholder-notice">
        Sample content — add real entries in Sanity Studio to replace this.
      </div>
    )}
    <ul class={`posts-list${!hasContent ? ' is-placeholder' : ''}`}>
      {displayPosts.map((post: any, i: number) => (
        <li class={`post-item ${i === 0 ? 'featured' : ''}`}>
          <article>
            {post.category && <span class="post-cat">{post.category}</span>}
            <h2>
              <a href={`/marginalia/${post.slug.current}`}>{post.title}</a>
            </h2>
            {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
            <div class="post-meta">
              <time>{formatDate(post.publishedAt)}</time>
              <a href={`/marginalia/${post.slug.current}`} class="read-more">Read →</a>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

</Layout>

<style>
  .posts-body { max-width: 860px; }

  .posts-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-item {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .post-item:last-child { border-bottom: none; }

  .post-item.featured {
    padding-bottom: 3rem;
    margin-bottom: 1rem;
  }
  .post-item.featured h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }

  .post-cat {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 0.6rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  h2 a { transition: color 0.2s; }
  h2 a:hover { color: var(--gold); }

  .post-excerpt {
    color: var(--text-muted);
    font-size: 0.97rem;
    line-height: 1.8;
    margin-bottom: 1.25rem;
    max-width: 680px;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .read-more {
    color: var(--gold);
    font-weight: 600;
    transition: color 0.2s;
  }
  .read-more:hover { color: var(--navy); }

  .placeholder-notice {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b07d2a;
    background: #fef3dc;
    border: 1px dashed #e8b455;
    border-radius: 4px;
    padding: 0.45rem 1rem;
    margin-bottom: 2.5rem;
  }

  .is-placeholder .post-item { opacity: 0.45; }
  .is-placeholder h2 { font-style: italic; }
</style>
