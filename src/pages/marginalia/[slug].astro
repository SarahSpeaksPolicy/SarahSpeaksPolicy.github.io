---
import Layout from '../../layouts/Layout.astro';
import { toHTML } from '@portabletext/to-html';
import { sanityClient } from '../../lib/sanity';

export async function getStaticPaths() {
  try {
    const posts = await sanityClient.fetch(`
      *[_type == "marginalia" && defined(slug.current)] | order(publishedAt desc) {
        title, publishedAt, excerpt, body,
        "slug": slug.current
      }
    `);
    return posts.map((post: any, i: number) => ({
      params: { slug: post.slug },
      props: { post, previousPost: posts[i + 1] ?? null },
    }));
  } catch (e) {
    return [];
  }
}

const { post, previousPost } = Astro.props;

const bodyHTML = post.body ? toHTML(post.body) : '';

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const prevMon = previousPost
  ? new Date(previousPost.publishedAt).toLocaleDateString('en-US', { month: 'short' })
  : '';
const prevDay = previousPost ? new Date(previousPost.publishedAt).getDate() : 0;
---

<Layout title={`${post.title} — Marginalia — Sarah Speaks Policy`} description={post.excerpt}>

  <div class="back-link">
    <a href="/marginalia">&larr; &nbsp; Back to Marginalia</a>
  </div>

  <div class="post-header">
    <div class="post-date">{formatDate(post.publishedAt)}</div>
    <h1 class="post-title">{post.title}</h1>
    {post.excerpt && <div class="post-standfirst">{post.excerpt}</div>}
  </div>

  <div class="asterism">&bull; &bull; &bull;</div>

  <article class="post-body">
    <div set:html={bodyHTML} />
    <div class="monogram">
      <img src="/smooth_small.png" alt="Sarah Pemberton Greenway signature" />
    </div>
  </article>

  {previousPost && (
    <section class="previously">
      <div class="block">
        <div class="label">Previously</div>
        <a href={`/marginalia/${previousPost.slug}`} class="marginalia-entry prev-entry">
          <div class="date">{prevMon}<br />{prevDay}</div>
          <div>
            <div class="title prev-title">{previousPost.title}</div>
            {previousPost.excerpt && <div class="description prev-desc">{previousPost.excerpt}</div>}
          </div>
          <div class="arrow prev-arrow">&#8594;</div>
        </a>
      </div>
    </section>
  )}

</Layout>

<style>
  .prev-entry {
    text-decoration: none;
    border-top: 0.5px solid var(--color-rule-soft);
    padding: 1.2rem 0 1rem;
    border-bottom: none;
  }

  .prev-title { font-size: 16px; }
  .prev-desc { font-size: 12px; }
  .prev-arrow { font-size: 14px; }
</style>
