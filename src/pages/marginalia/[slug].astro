---
import Layout from '../../layouts/Layout.astro';
import { marked } from 'marked';
import { createClient } from '@sanity/client';
import imageUrlBuilder from '@sanity/image-url';

export async function getStaticPaths() {
  try {
    const client = createClient({
      projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
      dataset: import.meta.env.PUBLIC_SANITY_DATASET ?? 'production',
      apiVersion: '2026-03-21',
      useCdn: false,
    });
    const posts = await client.fetch(`
      *[_type == "marginalia" && defined(slug.current)] {
        title, publishedAt, excerpt, body, headerImage,
        "slug": slug.current,
        "category": category->title
      }
    `);
    return posts.map((post: any) => ({
      params: { slug: post.slug },
      props: { post },
    }));
  } catch (e) {
    return [];
  }
}

const { post } = Astro.props;
const bodyHTML = post.body
  ? typeof post.body === 'string'
    ? await marked(post.body)
    : ''
  : '';

let headerImageUrl: string | null = null;
if (post.headerImage?.asset) {
  const client = createClient({
    projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
    dataset: import.meta.env.PUBLIC_SANITY_DATASET ?? 'production',
    apiVersion: '2024-01-01',
    useCdn: true,
  });
  const builder = imageUrlBuilder(client);
  headerImageUrl = builder.image(post.headerImage).width(1600).fit('max').url();
}

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${post.title} — Sarah Pemberton Greenway`} description={post.excerpt}>
  <article class="post-page">
    <header class="page-hero" style={headerImageUrl ? `--custom-header-image: url('${headerImageUrl}')` : ''}>
      <div class="container">
        {post.category && <span class="section-label">{post.category}</span>}
        <h1>{post.title}</h1>
        <div class="post-meta">
          <span>Sarah Pemberton Greenway</span>
          <span class="sep">·</span>
          <time>{formatDate(post.publishedAt)}</time>
        </div>
      </div>
    </header>

    <div class="post-body" id="blogcont">
      <h1 class="scrolledTitle">{post.title}</h1>
      <div class="prose" set:html={bodyHTML} />
      <div class="post-footer">
        <a href="/marginalia" class="back-link">← Back to Marginalia</a>
      </div>
    </div>
  </article>

  <script>
    const hero = document.querySelector('.post-page .page-hero');
    const scrolledTitle = document.querySelector('.post-page .scrolledTitle');
    const stickyHeader = document.querySelector('.site-header');

    if (hero && scrolledTitle) {
      let ticking = false;

      const updateHeroAndTitle = () => {
        const headerHeight = stickyHeader?.getBoundingClientRect().height ?? 68;
        const fadeDistance = Math.max(hero.offsetHeight - headerHeight, 200);
        const progress = Math.min(window.scrollY / fadeDistance, 1);

        hero.style.opacity = String(1 - progress);
        hero.style.transform = `translateY(${progress * -24}px)`;

        if (progress > 0.78) {
          scrolledTitle.classList.add('is-visible');
        } else {
          scrolledTitle.classList.remove('is-visible');
        }

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeroAndTitle);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      updateHeroAndTitle();
    }
  </script>
</Layout>

<style>
  .post-meta { color: rgba(255,255,255,0.5); font-size: 0.9rem; margin-top: 1rem; }
  .sep { margin: 0 0.5rem; }

  .post-page .page-hero {
    transition: opacity 0.12s linear;
    will-change: opacity, transform;
  }

  .post-body {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3rem) 2rem;
  }

  .scrolledTitle {
    position: fixed;
    top: 68px;
    left: 0;
    width: 100%;
    z-index: 95;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    margin-bottom: 0;
    background: var(--cream);
    padding-block: 0.65rem;
    padding-inline: max(2rem, calc((100vw - var(--max-width)) / 2 + 2rem));
    border-bottom: 2px solid #111111;
    color: #111111;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    line-height: 1.2;
    pointer-events: none;
  }

  .scrolledTitle.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .prose {
    max-width: 860px;
  }

  @media (max-width: 720px) {
    .scrolledTitle {
      padding-block: 0.55rem;
      border-bottom-width: 4px;
    }
  }

  @media (max-width: 600px) {
    .scrolledTitle {
      padding-inline: max(1.25rem, calc((100vw - var(--max-width)) / 2 + 1.25rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-page .page-hero,
    .scrolledTitle {
      transition: none;
    }
  }

  .prose { font-size: 1.1rem; line-height: 1.9; color: var(--text); }
  .prose :global(p) { margin-bottom: 1.5rem; }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--navy);
    margin: 2.5rem 0 1rem;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--navy);
    margin: 2rem 0 0.75rem;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--text-muted);
    font-size: 1.15rem;
  }
  .prose :global(a) { color: var(--gold); text-decoration: underline; }

  .post-footer { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .back-link { color: var(--gold); font-weight: 600; font-size: 0.9rem; transition: color 0.2s; }
  .back-link:hover { color: var(--navy); }
</style>
